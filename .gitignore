# ====================================
# 🧠 Root ignores
# ====================================
node_modules/
dist/
build/
.cache/
*.log

# Ignore environment files
.env
.env.*
!.env.example

# OS system files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# ====================================
# 🔥 Backend
# ====================================
backend/node_modules/
backend/.env
backend/.env.local
backend/dist/
backend/build/
backend/.vercel/
backend/.cache/
backend/vercel.json

# ====================================
# 🎨 Frontend (Vite + React)
# ====================================
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/dist/
frontend/build/
frontend/.vercel/
frontend/.cache/
frontend/vercel.json
frontend/.vite/
frontend/.vite-cache/

# Ignore vite output
**/dist/

# ====================================
# 📦 Package manager logs
# ====================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# ====================================
# 🚀 Deployment related
# ====================================
.vercel/
.netlify/
.heroku/

# ====================================
# 🏗 Temp, cache, misc
# ====================================
*.pid
*.seed
*.pid.lock
*.tgz
*.zip
